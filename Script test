-- Check if world position is within FOV circle
local function inFov(worldPos, fovRadius)
    if not Camera then return false end
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then return false end
    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    local dx = screenPos.X - cx
    local dy = screenPos.Y - cy
    return (dx * dx + dy * dy) <= (fovRadius * fovRadius)
end

-- Get screen distance from center
local function getScreenDist(worldPos)
    if not Camera then return math.huge end
    local screenPos, onScreen = Camera:WorldToViewportPoint(worldPos)
    if not onScreen then return math.huge end
    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    local dx = screenPos.X - cx
    local dy = screenPos.Y - cy
    return math.sqrt(dx * dx + dy * dy)
end

-- Find closest enemy to screen center within FOV
local function getClosestEnemyInFov(fovRadius, maxDist, checkFriend, aimPart)
    if not Camera then return nil end
    local best = nil
    local bestDist = math.huge
    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not (checkFriend and isFriend(plr)) then
                local char, head, hrp = getCharParts(plr)
                if char then
                    local dist = getDistance(hrp.Position, Camera.CFrame.Position)
                    if dist <= maxDist then
                        local targetPos = head.Position
                        if aimPart == "HumanoidRootPart" then
                            targetPos = hrp.Position
                        elseif aimPart == "Torso" then
                            local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                            if torso then targetPos = torso.Position end
                        elseif aimPart == "Random" then
                            local parts = getBodyParts(char)
                            if #parts > 0 then
                                targetPos = parts[math.random(1, #parts)].Position
                            end
                        end

                        local sp, onScreen = Camera:WorldToViewportPoint(targetPos)
                        if onScreen then
                            local dx = sp.X - cx
                            local dy = sp.Y - cy
                            local screenDist = math.sqrt(dx * dx + dy * dy)
                            if screenDist <= fovRadius and screenDist < bestDist then
                                bestDist = screenDist
                                best = {
                                    player = plr,
                                    char = char,
                                    head = head,
                                    hrp = hrp,
                                    dist = dist,
                                    screenDist = screenDist,
                                    targetPos = targetPos
                                }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Find closest enemy by 3D distance
local function getClosestEnemyByDist(maxDist, checkFriend)
    if not Camera then return nil end
    local best = nil
    local bestDist = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not (checkFriend and isFriend(plr)) then
                local char, head, hrp = getCharParts(plr)
                if char then
                    local dist = getDistance(hrp.Position, Camera.CFrame.Position)
                    if dist <= maxDist and dist < bestDist then
                        bestDist = dist
                        best = {
                            player = plr,
                            char = char,
                            head = head,
                            hrp = hrp,
                            dist = dist
                        }
                    end
                end
            end
        end
    end
    return best
end

-- Visibility check via raycast
local function isVisible(targetPos, ignoreList)
    if not Camera then return false end
    local rayParams = RaycastParams.new()
    rayParams.FilterDescendantsInstances = ignoreList or { LocalPlayer.Character }
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    local result = Workspace:Raycast(Camera.CFrame.Position, targetPos - Camera.CFrame.Position, rayParams)
    return result == nil
end

