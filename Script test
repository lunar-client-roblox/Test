                                    local size = Vector3.new(4, 6, 2)
                                    local cf = hrp.CFrame
                                    local corners = {}
                                    for sx = -1, 1, 2 do
                                        for sy = -1, 1, 2 do
                                            for sz = -1, 1, 2 do
                                                local corner = cf * CFrame.new(sx * size.X/2, sy * size.Y/2, sz * size.Z/2)
                                                local sp, vis = Camera:WorldToViewportPoint(corner.Position)
                                                table.insert(corners, { pos = sp, visible = vis })
                                            end
                                        end
                                    end
                                    if #corners == 8 then
                                        -- Front face
                                        d.box3d.PointA = Vector2.new(corners[1].pos.X, corners[1].pos.Y)
                                        d.box3d.PointB = Vector2.new(corners[2].pos.X, corners[2].pos.Y)
                                        d.box3d.PointC = Vector2.new(corners[4].pos.X, corners[4].pos.Y)
                                        d.box3d.PointD = Vector2.new(corners[3].pos.X, corners[3].pos.Y)
                                        d.box3d.Color = color
                                        d.box3d.Visible = true
                                    end
                                    d.box.Visible = false
                                    d.boxFill.Visible = false
                                else
                                    -- 2D Box
                                    d.box.Size = Vector2.new(width, height)
                                    d.box.Position = Vector2.new(x, y)
                                    d.box.Color = color
                                    d.box.Visible = true
                                    d.box3d.Visible = false

                                    if ESP.state.fillBox then
                                        d.boxFill.Size = Vector2.new(width, height)
                                        d.boxFill.Position = Vector2.new(x, y)
                                        d.boxFill.Color = color
                                        d.boxFill.Transparency = ESP.state.fillTransparency
                                        d.boxFill.Visible = true
                                    else
                                        d.boxFill.Visible = false
                                    end
                                end
                            else
                                d.box.Visible = false
                                d.boxFill.Visible = false
                                d.box3d.Visible = false
                            end

                            -- Name
                            if ESP.state.showName then
                                d.name.Text = plr.Name
                                d.name.Position = Vector2.new(pos.X, y - 18)
                                d.name.Color = color
                                d.name.Size = ESP.state.textSize
                                d.name.Visible = true
                            else
                                d.name.Visible = false
                            end

                            -- Distance
                            if ESP.state.showDist then
                                d.dist.Text = "[" .. math.floor(dist) .. "m]"
                                d.dist.Position = Vector2.new(pos.X, y + height + 4)
                                d.dist.Color = Theme.TextMuted
                                d.dist.Size = ESP.state.textSize - 1
                                d.dist.Visible = true
                            else
                                d.dist.Visible = false
                            end

                            -- Health bar
                            if ESP.state.showHealth and humanoid then
                                local hp = humanoid.Health / humanoid.MaxHealth
                                local barWidth = 2
                                local barHeight = height
                                local barX = x - 6
                                local barY = y

                                d.healthBg.Size = Vector2.new(barWidth, barHeight)
                                d.healthBg.Position = Vector2.new(barX, barY)
                                d.healthBg.Color = Color3.fromRGB(40, 40, 40)
                                d.healthBg.Visible = true

                                d.healthBar.Size = Vector2.new(barWidth, barHeight * hp)
                                d.healthBar.Position = Vector2.new(barX, barY + barHeight * (1 - hp))
                                d.healthBar.Color = Color3.fromRGB(
                                    math.floor(255 * (1 - hp)),
                                    math.floor(255 * hp),
                                    60
                                )
                                d.healthBar.Visible = true
                            else
                                d.healthBar.Visible = false
                                d.healthBg.Visible = false
                            end
                        else
                            -- Off screen — hide all
                            for _, dr in pairs(d) do
                                dr.Visible = false
                            end
                        end
                    else
                        -- Too far — hide
                        local d = ESP._drawings[plr]
                        if d then
                            for _, dr in pairs(d) do
                                dr.Visible = false
                            end
                        end
                    end
                end
            else
                -- Friend hidden
                local d = ESP._drawings[plr]
                if d then
                    for _, dr in pairs(d) do
                        dr.Visible = false
                    end
                end
            end
        end
    end
end)

-- Cleanup on player leave
Players.PlayerRemoving:Connect(function(plr)
    if ESP._drawings[plr] then
        for _, d in pairs(ESP._drawings[plr]) do
            pcall(function() d:Remove() end)
        end
        ESP._drawings[plr] = nil
    end
end)

registerModule("Render", ESP)

