-- [SECTION 14] VISUAL — TARGET ESP (PROCEDURAL ARROW)
--═══════════════════════════════════════════════════════════════════════

local TargetESP = {
    key = "targetesp",
    name = "Target ESP",
    defaultState = false,
    state = {
        enabled = false,
        spinSpeed = 1.0,     -- rotations per second
        radius = 4,          -- orbit radius (studs)
        maxDist = 100,       -- activation distance
        fovAngle = 30,       -- degrees — "looking at" threshold
        arrowSize = 64,      -- billboard size
        showWhenClose = true, -- activate when very close regardless of look direction
        closeDist = 10,      -- "close" threshold
        orbitMode = "Circle", -- Circle / Vertical / Horizontal
        pulseEffect = true,  -- scale pulsing
    },
}

TargetESP._gui = nil
TargetESP._img = nil
TargetESP._conn = nil
TargetESP._currentTarget = nil
TargetESP._angle = 0

-- Find target: looking at OR close
local function findTargetESP()
    if not Camera then return nil end
    local best = nil
    local bestScore = math.huge

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and not isFriend(plr) then
            local char, head, hrp = getCharParts(plr)
            if char then
                local dist = getDistance(hrp.Position, Camera.CFrame.Position)
                if dist <= TargetESP.state.maxDist then
                    local toTarget = (head.Position - Camera.CFrame.Position).Unit
                    local dot = Camera.CFrame.LookVector:Dot(toTarget)
                    local angle = math.deg(math.acos(clamp(dot, -1, 1)))

                    local isLooking = angle <= TargetESP.state.fovAngle
                    local isClose = TargetESP.state.showWhenClose and dist <= TargetESP.state.closeDist

                    if isLooking or isClose then
                        local score = angle + dist * 0.1
                        if score < bestScore then
                            bestScore = score
                            best = { player = plr, head = head, hrp = hrp, dist = dist }
                        end
                    end
                end
            end
        end
    end
    return best
end

TargetESP.onToggle = function(state)
    TargetESP.state.enabled = state

    if state then
        -- Generate procedural arrow
        local size = TargetESP.state.arrowSize
        local pixels = generateArrowPixels(size, Theme.Accent)
        local pngData = encodePNG(size, size, pixels)
        local assetPath = "deltax_target_arrow.png"
        local img = ""

        pcall(function()
            if writefile and getcustomasset then
                writefile(assetPath, pngData)
                img = getcustomasset(assetPath)
            end
        end)

        -- Create BillboardGui
        TargetESP._gui = Instance.new("BillboardGui")
        TargetESP._gui.Name = "DeltaX_TargetESP"
        TargetESP._gui.Size = UDim2.fromOffset(size, size)
        TargetESP._gui.StudsOffset = Vector3.new(0, 3, 0)
        TargetESP._gui.AlwaysOnTop = true
        TargetESP._gui.Enabled = false

        TargetESP._img = Instance.new("ImageLabel")
        TargetESP._img.Name = "Arrow"
        TargetESP._img.Size = UDim2.new(1, 0, 1, 0)
        TargetESP._img.BackgroundTransparency = 1
        TargetESP._img.Image = img ~= "" and img or "rbxassetid://0"
        TargetESP._img.ImageColor3 = Theme.Accent
        TargetESP._img.Parent = TargetESP._gui

        -- Orbit animation
        TargetESP._conn = RunService.RenderStepped:Connect(function(dt)
            if not TargetESP.state.enabled then return end

            local newTarget = findTargetESP()

            if newTarget then
                if TargetESP._currentTarget ~= newTarget.player then
                    TargetESP._currentTarget = newTarget.player
                    TargetESP._gui.Parent = newTarget.head
                    TargetESP._gui.Enabled = true
                end

                -- Spin
                TargetESP._angle = TargetESP._angle + dt * TargetESP.state.spinSpeed * 360

                -- Pulse effect
                local scale = 1.0
                if TargetESP.state.pulseEffect then
                    scale = 1.0 + 0.15 * math.sin(TargetESP._angle * 0.05)
                end
                TargetESP._img.Rotation = TargetESP._angle % 360

                -- Orbit
                local rad = math.rad(TargetESP._angle)
                local r = TargetESP.state.radius

                if TargetESP.state.orbitMode == "Circle" then
                    TargetESP._gui.StudsOffset = Vector3.new(
                        math.cos(rad) * r,
                        3 + math.sin(rad * 2) * 0.5,
                        math.sin(rad) * r
                    )
                elseif TargetESP.state.orbitMode == "Vertical" then
                    TargetESP._gui.StudsOffset = Vector3.new(
                        0,
                        3 + math.sin(rad) * r,
                        0
                    )
                elseif TargetESP.state.orbitMode == "Horizontal" then
                    TargetESP._gui.StudsOffset = Vector3.new(
                        math.cos(rad) * r,
                        3,
                        math.sin(rad) * r
                    )
                end
            else
                TargetESP._currentTarget = nil
                TargetESP._gui.Enabled = false
                TargetESP._gui.Parent = nil
            end
        end)
    else
        if TargetESP._conn then
            TargetESP._conn:Disconnect()
            TargetESP._conn = nil
        end
        if TargetESP._gui then
            TargetESP._gui:Destroy()
            TargetESP._gui = nil
            TargetESP._img = nil
        end
        TargetESP._currentTarget = nil
    end
end

TargetESP.buildSettings = function(scroll, def)
    CreateSlider(scroll, "Tốc độ quay", 0, 100, math.floor(def.state.spinSpeed * 100), function(v)
        def.state.spinSpeed = v / 100
    end)
    CreateSlider(scroll, "Bán kính vòng xoay", 1, 30, def.state.radius, function(v)
        def.state.radius = v
    end)
    CreateSlider(scroll, "Khoảng cách kích hoạt", 10, 500, def.state.maxDist, function(v)
        def.state.maxDist = v
    end)
    CreateSlider(scroll, "Góc nhìn (FOV)", 5, 90, def.state.fovAngle, function(v)
        def.state.fovAngle = v
    end)
    CreateSlider(scroll, "Arrow Size", 32, 256, def.state.arrowSize, function(v)
        def.state.arrowSize = v
        if def.state.enabled then
            def.onToggle(false)
            def.onToggle(true)
        end
    end)
    CreateToggle(scroll, "Kích hoạt khi ở gần", def.state.showWhenClose, function(v)
        def.state.showWhenClose = v
    end)
    CreateToggle(scroll, "Pulse Effect", def.state.pulseEffect, function(v)
        def.state.pulseEffect = v
    end)
    CreateButton(scroll, "Orbit Mode: " .. def.state.orbitMode, function()
        local modes = { "Circle", "Vertical", "Horizontal" }
        local idx = table.find(modes, def.state.orbitMode) or 1
        idx = idx % #modes + 1
        def.state.orbitMode = modes[idx]
    end)
end

