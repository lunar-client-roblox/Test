local function create(className, props, parent)
    local inst = Instance.new(className)
    for k, v in pairs(props) do inst[k] = v end
    if parent then inst.Parent = parent end
    return inst
end

local function tweenTo(inst, info, goal)
    local t = TweenService:Create(inst, info, goal)
    t:Play()
    return t
end

local FAST = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SMOOTH = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Clamp helper
local function clamp(v, min, max)
    return math.max(min, math.min(max, v))
end

-- Lerp helper
local function lerp(a, b, t)
    return a + (b - a) * t
end

-- Distance between two Vector3 points
local function getDistance(p1, p2)
    return (p1 - p2).Magnitude
end

-- Check if a point is on screen
local function isOnScreen(screenPos)
    return screenPos.Z > 0
end

