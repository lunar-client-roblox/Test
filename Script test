    CreateSlider(scroll, "Intensity", 0, 100, math.floor(def.state.intensity * 100), function(v)
        def.state.intensity = v / 100
    end)
    CreateSlider(scroll, "Star Density", 0, 500, def.state.starDensity, function(v)
        def.state.starDensity = v
    end)
    CreateSlider(scroll, "Wave Count", 1, 8, def.state.waveCount, function(v)
        def.state.waveCount = v
    end)
    CreateSlider(scroll, "Color Shift (hue)", 0, 360, def.state.colorShift, function(v)
        def.state.colorShift = v
    end)
end

