-- [SECTION 06] PNG ENCODER — Drawing → PNG bytes → getcustomasset
--═══════════════════════════════════════════════════════════════════════

-- Encode Drawing objects to PNG using executor's Drawing to buffer
-- This uses the fact that Drawing objects can be rendered to a buffer
-- via the executor's internal capture. We use a simpler approach:
-- generate the image data procedurally as raw pixels, then encode.

-- Simpler approach: generate raw RGBA pixel data, encode as PNG manually
local function encodePNG(width, height, pixels)
    -- PNG signature
    local png = {
        0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A
    }

    -- IHDR chunk
    local function writeChunk(data, chunkType, chunkData)
        local len = #chunkData
        -- Length (big-endian)
        table.insert(data, math.floor(len / 16777216) % 256)
        table.insert(data, math.floor(len / 65536) % 256)
        table.insert(data, math.floor(len / 256) % 256)
        table.insert(data, len % 256)
        -- Type
        for i = 1, #chunkType do
            table.insert(data, string.byte(chunkType, i))
        end
        -- Data
        for i = 1, #chunkData do
            table.insert(data, chunkData[i])
        end
        -- CRC32 (simplified — not full CRC, but works for our use)
        -- Actually we need real CRC32 for valid PNG
        local crc = 0xFFFFFFFF
        for i = 1, #chunkType do
            crc = crc ~ string.byte(chunkType, i)
            for _ = 1, 8 do
                crc = (crc >> 1) ~ (0xEDB88320 & -(crc & 1))
            end
        end
        for i = 1, #chunkData do
            crc = crc ~ chunkData[i]
            for _ = 1, 8 do
                crc = (crc >> 1) ~ (0xEDB88320 & -(crc & 1))
            end
        end
        crc = crc ~ 0xFFFFFFFF
        table.insert(data, math.floor(crc / 16777216) % 256)
        table.insert(data, math.floor(crc / 65536) % 256)
        table.insert(data, math.floor(crc / 256) % 256)
        table.insert(data, crc % 256)
    end

    -- IHDR data
    local ihdr = {}
    -- Width
    for i = 3, 0, -1 do
        table.insert(ihdr, math.floor(width / (256 ^ i)) % 256)
    end
    -- Height
    for i = 3, 0, -1 do
        table.insert(ihdr, math.floor(height / (256 ^ i)) % 256)
    end
    -- Bit depth = 8, Color type = 6 (RGBA)
    table.insert(ihdr, 8)
    table.insert(ihdr, 6)
    -- Compression, filter, interlace
    table.insert(ihdr, 0)
    table.insert(ihdr, 0)
    table.insert(ihdr, 0)

    writeChunk(png, "IHDR", ihdr)

    -- IDAT chunk — raw pixel data with filter byte per row
    local idat = {}
    for y = 0, height - 1 do
        table.insert(idat, 0) -- filter: none
        for x = 0, width - 1 do
            local idx = (y * width + x) * 4 + 1
            if pixels[idx] then
                table.insert(idat, pixels[idx])     -- R
                table.insert(idat, pixels[idx + 1]) -- G
                table.insert(idat, pixels[idx + 2]) -- B
                table.insert(idat, pixels[idx + 3]) -- A
            else
                table.insert(idat, 0)
                table.insert(idat, 0)
                table.insert(idat, 0)
                table.insert(idat, 255)
            end
        end
    end

    -- Compress IDAT using executor's zlib if available
    local idatStr = string.char(table.unpack(idat))
    local compressed
    if zlib and zlib.compress then
        compressed = zlib.compress(idatStr)
    else
        -- Fallback: store uncompressed (not valid PNG, but some executors accept)
        compressed = idatStr
    end

    local idatBytes = {}
    for i = 1, #compressed do
        table.insert(idatBytes, string.byte(compressed, i))
    end
    writeChunk(png, "IDAT", idatBytes)

    -- IEND
    writeChunk(png, "IEND", {})

    return string.char(table.unpack(png))
end

-- Generate aurora sky pixel data procedurally (no Drawing needed)
local function generateSkyPixels(width, height, speed, intensity, starCount)
    local pixels = {}
    local rng = Random.new()

    for y = 0, height - 1 do
        local t = y / height
        for x = 0, width - 1 do
            local idx = (y * width + x) * 4 + 1

            -- Base gradient
            local r, g, b
            if t < 0.3 then
                local lt = t / 0.3
                r = lerp(15, 138, lt)
                g = lerp(8, 43, lt)
                b = lerp(35, 226, lt)
            elseif t < 0.6 then
                local lt = (t - 0.3) / 0.3
                r = lerp(138, 0, lt)
                g = lerp(43, 180, lt)
                b = lerp(226, 180, lt)
            else
                local lt = (t - 0.6) / 0.4
                r = lerp(0, 5, lt)
                g = lerp(180, 15, lt)
                b = lerp(180, 50, lt)
            end

            -- Aurora waves
            local waveBoost = 0
            for w = 1, 4 do
                local waveY = height * (0.15 + w * 0.14)
                local waveAmp = 15 + w * 6
                local waveFreq = 0.01 + w * 0.003
                local wavePhase = w * 1.5 + speed * 0.5
                local wy = waveY + math.sin(x * waveFreq + wavePhase) * waveAmp
                local dist = math.abs(y - wy)
                if dist < 25 then
                    local alpha = (1 - dist / 25) * 0.4
                    waveBoost = waveBoost + alpha
                    g = math.min(255, g + 100 * alpha * intensity)
                    b = math.min(255, b + 50 * alpha * intensity)
                end
            end

            -- Stars (upper 70%)
            if t < 0.7 then
                local starChance = rng:NextNumber()
                if starChance > 0.998 then
                    local bright = rng:NextNumber(0.5, 1.0)
                    r = 255 * bright
                    g = 255 * bright
                    b = 255 * bright
                end
            end

            pixels[idx] = math.floor(clamp(r * intensity, 0, 255))
            pixels[idx + 1] = math.floor(clamp(g * intensity, 0, 255))
            pixels[idx + 2] = math.floor(clamp(b * intensity, 0, 255))
            pixels[idx + 3] = 255
        end
    end

    return pixels
end

-- Generate arrow pixels
local function generateArrowPixels(size, color)
    local pixels = {}
    local c = size / 2

    for y = 0, size - 1 do
        for x = 0, size - 1 do
            local idx = (y * size + x) * 4 + 1

            -- Arrow shape: upward triangle
            local dx = math.abs(x - c)
            local dy = y - c * 0.2
            local inArrow = false

            if dy > 0 and dy < size * 0.8 then
                local maxDx = dy * 0.7
                if dx < maxDx then
                    inArrow = true
                end
            end

            if inArrow then
                -- Glow effect near edges
                local edgeDist = dx / (dy * 0.7)
                local alpha = 1 - edgeDist * 0.3

                pixels[idx] = math.floor(color.R * 255 * alpha)
                pixels[idx + 1] = math.floor(color.G * 255 * alpha)
                pixels[idx + 2] = math.floor(color.B * 255 * alpha)
                pixels[idx + 3] = 255
            else
                pixels[idx] = 0
                pixels[idx + 1] = 0
                pixels[idx + 2] = 0
                pixels[idx + 3] = 0
            end
        end
    end

    return pixels
end

-- Generate shiftlock icon pixels
local function generateShiftlockPixels(size, color)
    local pixels = {}
    local c = size / 2
    local r = size * 0.3
    local thickness = math.max(2, size * 0.04)

    for y = 0, size - 1 do
        for x = 0, size - 1 do
            local idx = (y * size + x) * 4 + 1
            local dx = x - c
            local dy = y - c
            local dist = math.sqrt(dx * dx + dy * dy)

            local inRing = dist > r - thickness and dist < r + thickness
            local inDot = dist < size * 0.06
            local inCross = false

            -- Crosshair lines
            local lineLen = size * 0.12
            local gap = size * 0.05
            if math.abs(dx) < thickness / 2 and math.abs(dy) > r + gap and math.abs(dy) < r + gap + lineLen then
                inCross = true
            end
            if math.abs(dy) < thickness / 2 and math.abs(dx) > r + gap and math.abs(dx) < r + gap + lineLen then
                inCross = true
            end

            if inRing or inDot or inCross then
                pixels[idx] = math.floor(color.R * 255)
                pixels[idx + 1] = math.floor(color.G * 255)
                pixels[idx + 2] = math.floor(color.B * 255)
                pixels[idx + 3] = 255
            else
                pixels[idx] = 0
                pixels[idx + 1] = 0
                pixels[idx + 2] = 0
                pixels[idx + 3] = 0
            end
        end
    end

    return pixels
end

