local function hookSilent()
    if AimSilent._hooked then return end
    AimSilent._hooked = true

    local mt = getrawmetatable and getrawmetatable(game)
    if not mt then return end

    local oldNamecall = mt.__namecall
    setreadonly(mt, false)

    mt.__namecall = newcclosure(function(self, ...)
        local method = getnamecallmethod()
        if AimSilent.state.enabled
            and (method == "FireServer" or method == "InvokeServer")
            and typeof(self) == "Instance"
            and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then

            -- Hit chance roll
            if math.random(1, 100) <= AimSilent.state.hitChance then
                local target = getClosestEnemyInFov(
                    AimSilent.state.fov,
                    AimSilent.state.maxDist,
                    AimSilent.state.checkFriend,
                    "Head"
                )
                if target then
                    local args = { ... }
                    local modified = false
                    for i, arg in ipairs(args) do
                        if typeof(arg) == "Vector3" then
                            args[i] = target.head.Position
                            modified = true
                        elseif typeof(arg) == "CFrame" then
                            args[i] = CFrame.new(target.head.Position)
                            modified = true
                        end
                    end
                    if modified then
                        return oldNamecall(self, unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)

    setreadonly(mt, true)
end

AimSilent.onToggle = function(state)
    AimSilent.state.enabled = state
    if state then
        pcall(hookSilent)
    end
end

registerModule("Combat", AimSilent)

