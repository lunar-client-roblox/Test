local SkyAurora = {
    key = "sky",
    name = "Sky Aurora",
    defaultState = false,
    state = {
        enabled = false,
        speed = 0.5,
        intensity = 1.0,
        starDensity = 100,
        waveCount = 4,
        colorShift = 0,     -- 0-360 hue rotation
    },
}

SkyAurora._skyObj = nil
SkyAurora._oldSky = nil
SkyAurora._conn = nil
SkyAurora._offset = 0

SkyAurora.onToggle = function(state)
    SkyAurora.state.enabled = state
    local lighting = Lighting

    if state then
        -- Save old sky
        if not SkyAurora._oldSky then
            SkyAurora._oldSky = lighting:FindFirstChildOfClass("Sky")
        end
        if SkyAurora._oldSky then
            SkyAurora._oldSky.Parent = nil
        end

        -- Generate procedural sky texture
        local texSize = 512
        local pixels = generateSkyPixels(
            texSize,
            texSize,
            SkyAurora.state.speed,
            SkyAurora.state.intensity,
            SkyAurora.state.starDensity
        )

        -- Encode and load
        local pngData = encodePNG(texSize, texSize, pixels)
        local assetPath = "deltax_aurora_sky.png"

        local skyImg = ""
        pcall(function()
            if writefile and getcustomasset then
                writefile(assetPath, pngData)
                skyImg = getcustomasset(assetPath)
            end
        end)

        -- Create Sky object
        skyObj = Instance.new("Sky")
        skyObj.Name = "DeltaX_AuroraSky"
        if skyImg ~= "" then
            skyObj.SkyboxBk = skyImg
            skyObj.SkyboxDn = skyImg
            skyObj.SkyboxFt = skyImg
            skyObj.SkyboxLf = skyImg
            skyObj.SkyboxRt = skyImg
            skyObj.SkyboxUp = skyImg
        end
        skyObj.StarCount = SkyAurora.state.starDensity * 10
        skyObj.SunAngularSize = 0
        skyObj.MoonAngularSize = 0
        skyObj.Parent = lighting

        -- Animation loop
        SkyAurora._conn = RunService.RenderStepped:Connect(function(dt)
            if not SkyAurora.state.enabled then return end
            SkyAurora._offset = SkyAurora._offset + dt * SkyAurora.state.speed

            -- Shift ClockTime for subtle movement
            lighting.ClockTime = (lighting.ClockTime + dt * SkyAurora.state.speed * 0.02) % 24

            -- Adjust brightness based on intensity
            lighting.Brightness = 1 + (SkyAurora.state.intensity - 0.5) * 0.5
        end)
    else
        if SkyAurora._conn then
            SkyAurora._conn:Disconnect()
            SkyAurora._conn = nil
        end
        if skyObj then
            skyObj:Destroy()
            skyObj = nil
        end
        if SkyAurora._oldSky then
            SkyAurora._oldSky.Parent = lighting
            SkyAurora._oldSky = nil
        end
        lighting.Brightness = 1
    end
end

SkyAurora.buildSettings = function(scroll, def)
    CreateSlider(scroll, "Tốc độ chuyển động", 0, 100, math.floor(def.state.speed * 100), function(v)
        def.state.speed = v / 100
