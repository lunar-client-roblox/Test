-- FOV Circle render
RunService.RenderStepped:Connect(function()
    if not Aimbot.state.enabled or not Aimbot.state.fovVisible then
        if Aimbot._fovCircle then
            Aimbot._fovCircle.Visible = false
        end
        return
    end

    if not Aimbot._fovCircle then
        Aimbot._fovCircle = Drawing.new("Circle")
        Aimbot._fovCircle.Thickness = 1
        Aimbot._fovCircle.Filled = false
    end

    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2
    Aimbot._fovCircle.Position = Vector2.new(cx, cy)
    Aimbot._fovCircle.Radius = Aimbot.state.fov
    Aimbot._fovCircle.Color = Theme.Accent
    Aimbot._fovCircle.Visible = true
end)

-- Main aimbot loop
RunService.RenderStepped:Connect(function(dt)
    if not Aimbot.state.enabled then return end
    if not Camera then return end

    -- Keybind check
    if Aimbot.state.triggerKey ~= "None" and not Aimbot._keyDown then
        return
    end

    local target = nil

    -- Sticky target: giữ mục tiêu cũ nếu còn valid
    if Aimbot.state.stickyTarget and Aimbot._currentTarget then
        local plr = Aimbot._currentTarget.player
        if plr and plr.Parent then
            local char, head, hrp = getCharParts(plr)
            if char then
                local dist = getDistance(hrp.Position, Camera.CFrame.Position)
                if dist <= Aimbot.state.maxDist then
                    local sd = getScreenDist(head.Position)
                    if sd <= Aimbot.state.fov * 1.5 then
                        target = {
                            player = plr,
                            char = char,
                            head = head,
                            hrp = hrp,
                            dist = dist,
                            targetPos = head.Position
                        }
                    end
                end
            end
        end
        if not target then
            Aimbot._currentTarget = nil
        end
    end

    -- Find new target if no sticky
    if not target then
        target = getClosestEnemyInFov(
            Aimbot.state.fov,
            Aimbot.state.maxDist,
            Aimbot.state.checkFriend,
            Aimbot.state.aimPart
        )
        if target then
            Aimbot._currentTarget = target
        end
    end

    if not target then return end

    local aimPos = target.targetPos
    if Aimbot.state.aimPart == "HumanoidRootPart" then
        aimPos = target.hrp.Position
    elseif Aimbot.state.aimPart == "Torso" then
        local torso = target.char:FindFirstChild("Torso") or target.char:FindFirstChild("UpperTorso")
        if torso then aimPos = torso.Position end
    elseif Aimbot.state.aimPart == "Random" then
        local parts = getBodyParts(target.char)
        if #parts > 0 then
            aimPos = parts[math.random(1, #parts)].Position
        end
    end

    -- Prediction: compensate for bullet travel / ping
    if Aimbot.state.prediction > 0 and target.hrp then
        local vel = target.hrp.Velocity
        aimPos = aimPos + vel * (Aimbot.state.prediction / 1000)
    end

    -- Visible check
    if Aimbot.state.visibleCheck then
        if not isVisible(aimPos, { LocalPlayer.Character, target.char }) then
            return
        end
    end

    local targetCFrame = CFrame.new(Camera.CFrame.Position, aimPos)
    local alpha = 1 - Aimbot.state.smoothness
    alpha = clamp(alpha, 0.05, 1)
    Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
end)

-- Keybind handling
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if Aimbot.state.triggerKey ~= "None" and input.KeyCode.Name == Aimbot.state.triggerKey then
        Aimbot._keyDown = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if Aimbot.state.triggerKey ~= "None" and input.KeyCode.Name == Aimbot.state.triggerKey then
        Aimbot._keyDown = false
    end
end)

registerModule("Combat", Aimbot)

