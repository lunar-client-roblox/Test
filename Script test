-- Generate a 512x512 aurora sky texture using Drawing API
-- Returns: table of 6 Drawing objects (Bk, Dn, Ft, Lf, Rt, Up)
local function generateAuroraSky(speed, intensity, starCount)
    local size = Vector2.new(512, 512)
    local center = size / 2
    local drawings = {}

    -- Base gradient: deep purple to teal
    local steps = 64
    for i = 0, steps do
        local t = i / steps
        local y = t * size.Y
        local h = size.Y / steps

        -- Color gradient: purple -> magenta -> teal -> dark blue
        local r, g, b
        if t < 0.3 then
            -- Deep purple to magenta
            local lt = t / 0.3
            r = lerp(20, 138, lt)
            g = lerp(10, 43, lt)
            b = lerp(40, 226, lt)
        elseif t < 0.6 then
            -- Magenta to teal
            local lt = (t - 0.3) / 0.3
            r = lerp(138, 0, lt)
            g = lerp(43, 180, lt)
            b = lerp(226, 180, lt)
        else
            -- Teal to dark blue
            local lt = (t - 0.6) / 0.4
            r = lerp(0, 5, lt)
            g = lerp(180, 20, lt)
            b = lerp(180, 60, lt)
        end

        local color = Color3.fromRGB(
            math.floor(r * intensity),
            math.floor(g * intensity),
            math.floor(b * intensity)
        )

        -- Draw horizontal band
        local band = Drawing.new("Square")
        band.Size = Vector2.new(size.X, h + 1)
        band.Position = Vector2.new(0, y)
        band.Color = color
        band.Filled = true
        band.Visible = true
        table.insert(drawings, band)
    end

    -- Aurora wave effect — sinusoidal green/purple bands
    local waveCount = 5
    for w = 1, waveCount do
        local waveY = size.Y * (0.2 + w * 0.12)
        local waveAmp = 20 + w * 8
        local waveFreq = 0.008 + w * 0.002
        local wavePhase = w * 1.3

        local points = {}
        local step = 8
        for x = 0, size.X, step do
            local y = waveY + math.sin(x * waveFreq + wavePhase) * waveAmp
            table.insert(points, Vector2.new(x, y))
        end

        -- Draw wave as connected lines
        for i = 1, #points - 1 do
            local alpha = 0.3 + 0.1 * math.sin(w * 0.7)
            local wr = math.floor(80 * alpha * intensity)
            local wg = math.floor(255 * alpha * intensity)
            local wb = math.floor(120 * alpha * intensity)
            drawLine(drawings, points[i], points[i + 1],
                Color3.fromRGB(wr, wg, wb), 3)
        end
    end

    -- Stars
    local rng = Random.new()
    for i = 1, starCount do
        local x = rng:NextInteger(0, size.X)
        local y = rng:NextInteger(0, math.floor(size.Y * 0.7))
        local bright = rng:NextNumber(0.3, 1.0)
        local starSize = rng:NextInteger(1, 2)

        local sr = math.floor(255 * bright)
        local sg = math.floor(255 * bright)
        local sb = math.floor(255 * bright)

        local star = Drawing.new("Square")
        star.Size = Vector2.new(starSize, starSize)
        star.Position = Vector2.new(x, y)
        star.Color = Color3.fromRGB(sr, sg, sb)
        star.Filled = true
        star.Visible = true
        table.insert(drawings, star)
    end

    -- Nebula glow spots
    for i = 1, 8 do
        local nx = rng:NextInteger(50, size.X - 50)
        local ny = rng:NextInteger(50, math.floor(size.Y * 0.5))
        local nr = rng:NextInteger(30, 80)
        local hue = rng:NextNumber()

        local nr_, ng_, nb_
        if hue < 0.33 then
            nr_, ng_, nb_ = 100, 50, 200
        elseif hue < 0.66 then
            nr_, ng_, nb_ = 0, 150, 200
        else
            nr_, ng_, nb_ = 200, 50, 150
        end

        -- Glow: concentric circles
        for gr = nr, 1, -4 do
            local alpha = (1 - gr / nr) * 0.15
            local gc = Color3.fromRGB(
                math.floor(nr_ * alpha * intensity),
                math.floor(ng_ * alpha * intensity),
                math.floor(nb_ * alpha * intensity)
            )
            drawCircle(drawings, Vector2.new(nx, ny), gr, gc, true)
        end
    end

    return drawings
end

-- Generate a simple arrow/chevron texture for Target ESP
local function generateArrowTexture(color, size)
    local drawings = {}
    local s = size or 64
    local c = s / 2

    -- Arrow shape: triangle pointing up with outline
    local points = {
        Vector2.new(c, c * 0.2),       -- top
        Vector2.new(c * 1.6, c * 1.2), -- bottom right
        Vector2.new(c * 0.4, c * 1.2), -- bottom left
    }

    -- Outer glow
    for i = 1, 3 do
        local glowColor = Color3.fromRGB(
            math.floor(color.R * 255 * (0.3 / i)),
            math.floor(color.G * 255 * (0.3 / i)),
            math.floor(color.B * 255 * (0.3 / i))
        )
        local offset = i * 2
        local glowPoints = {
            points[1] + Vector2.new(0, -offset),
            points[2] + Vector2.new(offset, offset),
            points[3] + Vector2.new(-offset, offset),
        }
        drawTriangle(drawings, glowPoints, glowColor, true)
    end

    -- Main arrow
    drawTriangle(drawings, points, color, true)

    -- Inner highlight
    local innerPoints = {
        points[1] + Vector2.new(0, s * 0.08),
        points[2] - Vector2.new(s * 0.12, s * 0.12),
        points[3] + Vector2.new(s * 0.12, -s * 0.12),
    }
    local highlight = Color3.fromRGB(
        math.min(255, math.floor(color.R * 255 * 1.3)),
        math.min(255, math.floor(color.G * 255 * 1.3)),
        math.min(255, math.floor(color.B * 255 * 1.3))
    )
    drawTriangle(drawings, innerPoints, highlight, true)

    return drawings
end

-- Generate shift lock icon — crosshair with lock indicator
local function generateShiftlockIcon(color, size)
    local drawings = {}
    local s = size or 64
    local c = s / 2
    local r = s * 0.35

    -- Outer ring
    drawCircle(drawings, Vector2.new(c, c), r, color, false, 2)

    -- Inner dot
    drawCircle(drawings, Vector2.new(c, c), s * 0.06, color, true)

    -- Crosshair lines
    local gap = s * 0.08
    local len = s * 0.15
    drawLine(drawings, Vector2.new(c, c - r - gap), Vector2.new(c, c - r - gap - len), color, 2)
    drawLine(drawings, Vector2.new(c, c + r + gap), Vector2.new(c, c + r + gap + len), color, 2)
    drawLine(drawings, Vector2.new(c - r - gap, c), Vector2.new(c - r - gap - len, c), color, 2)
    drawLine(drawings, Vector2.new(c + r + gap, c), Vector2.new(c + r + gap + len, c), color, 2)

    -- Lock arc (bottom half)
    local arcSteps = 12
    local arcPoints = {}
    for i = 0, arcSteps do
        local angle = math.rad(180 + (i / arcSteps) * 180)
        local px = c + math.cos(angle) * r * 0.6
        local py = c + math.sin(angle) * r * 0.6 + s * 0.1
        table.insert(arcPoints, Vector2.new(px, py))
    end
    for i = 1, #arcPoints - 1 do
        drawLine(drawings, arcPoints[i], arcPoints[i + 1], color, 2)
    end

    return drawings
end

