-- Draw a filled circle on a Drawing canvas
local function drawCircle(drawings, center, radius, color, filled, thickness)
    local circle = Drawing.new("Circle")
    circle.Position = center
    circle.Radius = radius
    circle.Color = color
    circle.Filled = filled
    circle.Thickness = thickness or 1
    circle.Visible = true
    table.insert(drawings, circle)
    return circle
end

-- Draw a line on a Drawing canvas
local function drawLine(drawings, from, to, color, thickness)
    local line = Drawing.new("Line")
    line.From = from
    line.To = to
    line.Color = color
    line.Thickness = thickness or 1
    line.Visible = true
    table.insert(drawings, line)
    return line
end

-- Draw a quad on a Drawing canvas
local function drawQuad(drawings, points, color, filled, thickness)
    local quad = Drawing.new("Quad")
    quad.PointA = points[1]
    quad.PointB = points[2]
    quad.PointC = points[3]
    quad.PointD = points[4]
    quad.Color = color
    quad.Filled = filled or false
    quad.Thickness = thickness or 1
    quad.Visible = true
    table.insert(drawings, quad)
    return quad
end

-- Draw text on a Drawing canvas
local function drawText(drawings, pos, text, color, size, center, outline)
    local txt = Drawing.new("Text")
    txt.Position = pos
    txt.Text = text
    txt.Color = color
    txt.Size = size or 13
    txt.Center = center or false
    txt.Outline = outline or true
    txt.Visible = true
    table.insert(drawings, txt)
    return txt
end

-- Draw a triangle on a Drawing canvas
local function drawTriangle(drawings, points, color, filled, thickness)
    local tri = Drawing.new("Triangle")
    tri.PointA = points[1]
    tri.PointB = points[2]
    tri.PointC = points[3]
    tri.Color = color
    tri.Filled = filled or false
    tri.Thickness = thickness or 1
    tri.Visible = true
    table.insert(drawings, tri)
    return tri
end

-- Clear all drawings in a table
local function clearDrawings(drawings)
    for _, d in ipairs(drawings) do
        pcall(function() d:Remove() end)
    end
    table.clear(drawings)
end

